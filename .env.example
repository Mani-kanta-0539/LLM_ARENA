# ============================================================
# LLM Arena — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your own keys:
#   cp .env.example .env.local
# ============================================================

# Supabase API Credentials
NEXT_PUBLIC_SUPABASE_URL="your_supabase_url"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_supabase_anon_key"

# LLM API Keys (Optional: You can set them here or in the UI dashboard)
NEXT_PUBLIC_OPENAI_API_KEY="your_openai_api_key"
NEXT_PUBLIC_ANTHROPIC_API_KEY="your_anthropic_api_key"
NEXT_PUBLIC_GEMINI_API_KEY="your_gemini_api_key"
NEXT_PUBLIC_DEEPSEEK_API_KEY="your_deepseek_api_key"
NEXT_PUBLIC_GROQ_API_KEY="your_groq_api_key"
NEXT_PUBLIC_CEREBRAS_API_KEY="your_cerebras_api_key"
NEXT_PUBLIC_SCALEWAY_API_KEY="your_scaleway_api_key"

# ElevenLabs (Text-to-Speech)
ELEVENLABS_API_KEY="your_elevenlabs_api_key"

# Pexels API (for research paper images)
PEXELS_API_KEY="your_pexels_api_key"
NEXT_PUBLIC_PEXELS_API_KEY="your_pexels_api_key"

# LinkedIn OAuth
LINKEDIN_CLIENT_ID="your_linkedin_client_id"
LINKEDIN_CLIENT_SECRET="your_linkedin_client_secret"
LINKEDIN_REDIRECT_URI="http://localhost:3000/api/auth/linkedin/callback"

# Google OAuth (Gmail)
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"
